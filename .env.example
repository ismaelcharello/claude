# =============================================================================
# Savana Command Center
# =============================================================================
# Started with `npm run savana` (or `npm run savana:demo`). The launcher wires
# the 3D office to the Savana backend automatically; you do not need to set the
# CLAW3D_GATEWAY_* variables below for Savana.
#
# Never put secrets in NEXT_PUBLIC_* variables: they are shipped to the browser.

# Agent runtime: "none" (default — nothing executes), "demo" (scripted,
# simulated, separate database) or "claude-code" (architecture only: records
# planned runs, executes nothing in this version).
# SAVANA_RUNTIME=none

# Savana backend (Node + TypeScript). Only loopback hosts are accepted because
# the backend has no authentication yet.
# SAVANA_API_HOST=127.0.0.1
# SAVANA_API_PORT=3100

# Where the SQLite databases live (savana.db / savana-demo.db).
# SAVANA_DATA_DIR=./data

# Demo mode: delay between simulated steps, in milliseconds.
# SAVANA_DEMO_STEP_MS=3500

# Claude Code runtime (started by `npm run savana:ia`; see IMPLEMENTATION_STATUS.md).
# SAVANA_CLAUDE_BIN=claude
# SAVANA_RUN_TIMEOUT_MS=600000
# SAVANA_MAX_TURNS=25
# For FORJA (code) — not enabled yet in this version:
# SAVANA_REPO_ROOT=/absolute/path/to/the/repository/forja/works/on
# SAVANA_WORKTREE_ROOT=/absolute/path/outside/that/repository
# SAVANA_CLAUDE_CODE_ENABLED=false
# Claude Code authenticates with its own local login (`claude`), or with
# ANTHROPIC_API_KEY set in the backend's environment — never in this file if
# it is committed, and never in a NEXT_PUBLIC_* variable.

# =============================================================================
# Claw3D (base project) settings
# =============================================================================
# Browser/client gateway URL (build-time — requires `npm run build` after changes)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Runtime gateway URL — takes effect on restart without a rebuild.
# Use this instead of NEXT_PUBLIC_GATEWAY_URL when you want to change the
# gateway endpoint without re-running `npm run build`.
# CLAW3D_GATEWAY_URL=ws://localhost:18789
# CLAW3D_GATEWAY_TOKEN=
# Optional: tell Studio which backend that runtime gateway URL represents.
# Valid values: openclaw, hermes, demo, custom
# CLAW3D_GATEWAY_ADAPTER_TYPE=openclaw


# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=change-me-local-dev
# HERMES_MODEL=hermes-agent

# Debug UI
DEBUG=true

# App server
# PORT=3000
# HOST=127.0.0.1

# Optional: required only for public/remote deployments
# STUDIO_ACCESS_TOKEN=
# Advanced only: some gateway-host operations can still use SSH, but marketplace skill install does not require it.
# OPENCLAW_GATEWAY_SSH_TARGET=
# OPENCLAW_GATEWAY_SSH_USER=
# OPENCLAW_GATEWAY_SSH_PORT=
# OPENCLAW_GATEWAY_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Hermes Agent adapter (alternative to OpenClaw)
# Run `npm run hermes-adapter` to start the adapter, then connect Claw3D to ws://localhost:18789
# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=
# HERMES_ADAPTER_PORT=18789
# HERMES_MODEL=hermes
# HERMES_AGENT_NAME=Hermes
# If CLAW3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Demo gateway (no OpenClaw or Hermes required)
# Run `npm run demo-gateway` and connect Claw3D to ws://localhost:18789
# DEMO_ADAPTER_PORT=18789
# If CLAW3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Optional: voice features
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
